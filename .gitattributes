# 默认：根据文件内容自动检测，但行尾在工作树保留 git 视角
* text=auto

# Shell scripts 必须使用 LF（Windows 上 Git Bash 也是 LF；CRLF 会导致 #!/bin/bash 解释失败）
*.sh text eol=lf
scripts/_pyrun.sh text eol=lf

# Python 脚本统一 LF（避免跨平台编码问题）
*.py text eol=lf

# Markdown / 配置文件用 LF（避免 diff 噪音）
*.md text eol=lf
*.json text eol=lf
*.template text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

# PowerShell 脚本用 CRLF（Windows 原生）
*.ps1 text eol=crlf

# Windows 批处理脚本用 CRLF（cmd.exe 解析更稳定）
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制文件（保险起见声明）
*.png binary
*.jpg binary
*.pdf binary
